<?xml version="1.0" encoding="utf-8"?>
<!-- Header stays thin: the panel is already sharing a phone screen with a
     game, so every row of chrome is a row of comp the user cannot see. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0F16">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp">

        <TextView
            android:id="@+id/back"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/back_arrow"
            android:textColor="#7C8798"
            android:textSize="18sp"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/mode"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:textColor="#E8ECF3"
            android:textSize="14sp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/close"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/close_glyph"
            android:textColor="#7C8798"
            android:textSize="18sp"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
